{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unisydneybuddy.local/schemas/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "claim_path",
    "source_id",
    "source_type",
    "source_title",
    "locator",
    "confidence",
    "verification_status",
    "language"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "claim_path": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_type": {
      "type": "string",
      "enum": ["unit_outline", "module", "lecture", "workshop", "assignment", "rubric", "announcement", "email", "other"]
    },
    "source_title": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "excerpt": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "verification_status": {
      "type": "string",
      "enum": ["unverified", "ai_extracted", "human_confirmed", "conflict"]
    },
    "language": {"type": "string", "minLength": 2},
    "contains_sensitive_data": {"type": "boolean", "default": false}
  }
}

