{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unisydneybuddy.local/schemas/course.schema.json",
  "title": "Course",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "code",
    "name_original",
    "name_localized",
    "institution",
    "term",
    "sessions",
    "tools_and_channels",
    "rules",
    "assessment_ids",
    "week_ids",
    "unknowns",
    "evidence_ids"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "code": {"type": "string", "minLength": 1},
    "name_original": {"type": "string", "minLength": 1},
    "name_localized": {"type": "object", "additionalProperties": {"type": "string"}},
    "institution": {"type": "string", "minLength": 1},
    "term": {"type": "string", "minLength": 1},
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "day", "starts_at", "ends_at", "location", "attendance_required"],
        "properties": {
          "type": {"type": "string", "enum": ["lecture", "workshop", "tutorial", "online", "other"]},
          "day": {"type": ["string", "null"]},
          "starts_at": {"type": ["string", "null"]},
          "ends_at": {"type": ["string", "null"]},
          "location": {"type": ["string", "null"]},
          "attendance_required": {"type": ["boolean", "null"]}
        }
      }
    },
    "tools_and_channels": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "assessment_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "week_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

