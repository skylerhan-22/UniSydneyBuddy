{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unisydneybuddy.local/schemas/assessment.schema.json",
  "title": "Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "course_id",
    "title_original",
    "title_localized",
    "mode",
    "weight_percent",
    "due_at",
    "deliverables",
    "intermediate_deliverables",
    "dependencies",
    "requirements",
    "evidence_ids"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "course_id": {"type": "string", "minLength": 1},
    "title_original": {"type": "string", "minLength": 1},
    "title_localized": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "mode": {"type": "string", "enum": ["individual", "group", "mixed", "unknown"]},
    "weight_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "due_at": {"type": ["string", "null"], "format": "date-time"},
    "page_limit": {"type": ["integer", "null"], "minimum": 1},
    "team_size": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {"type": "integer", "minimum": 1},
            "max": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title_original", "title_localized"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title_original": {"type": "string", "minLength": 1},
          "title_localized": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      }
    },
    "intermediate_deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title_original", "due_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title_original": {"type": "string", "minLength": 1},
          "title_localized": {"type": "object", "additionalProperties": {"type": "string"}},
          "due_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

